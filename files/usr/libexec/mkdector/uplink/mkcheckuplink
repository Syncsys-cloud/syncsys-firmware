#!/bin/sh
# mkdector - Uplink / Internet connectivity checks
#
# ملاحظة إصلاح: النسخة السابقة كانت تفتح كائن issues متداخلًا داخل facts
# عند اكتشاف مشكلة فلا تظهر المشكلة أبدًا في issues الجذر الذي تقرأه الواجهة.
# هذه النسخة تحسب النتائج أولًا ثم تبني JSON مرة واحدة، وتضيف قياسات RTT.

. /usr/share/libubox/jshn.sh 2>/dev/null

get_mode_id() {
	local f="/tmp/mkdector/topology.result.json"
	if [ -r "$f" ] && command -v jsonfilter >/dev/null 2>&1; then
		jsonfilter -i "$f" -e '@.facts.mode_id' 2>/dev/null
		return
	fi
	echo ""
}

get_default_gw() {
	ip -4 route show default 2>/dev/null | awk '/default/{print $3; exit}'
}

ping_rtt_ms() {
	# يطبع متوسط RTT بالمللي ثانية أو لا شيء عند الفشل
	ping -4 -c 2 -W 1 "$1" 2>/dev/null | awk -F'/' '/round-trip|rtt/{printf "%.0f", $4}'
}

main() {
	local mode_id gw
	local no_route=0 gw_unreach=0 inet_unreach=0 dns_fail=0
	local gw_rtt="" inet_rtt="" dns_host="openwrt.org"

	mode_id="$(get_mode_id)"
	gw="$(get_default_gw)"

	if [ -z "$gw" ]; then
		no_route=1
	else
		gw_rtt="$(ping_rtt_ms "$gw")"
		if [ -z "$gw_rtt" ]; then
			gw_unreach=1
		else
			inet_rtt="$(ping_rtt_ms 1.1.1.1)"
			if [ -z "$inet_rtt" ]; then
				inet_unreach=1
			elif command -v nslookup >/dev/null 2>&1; then
				nslookup "$dns_host" >/dev/null 2>&1 || dns_fail=1
			fi
		fi
	fi

	local total=$((no_route + gw_unreach + inet_unreach + dns_fail))

	json_init

	json_add_object issues
	json_add_boolean no_default_route "$no_route"
	json_add_boolean gateway_unreachable "$gw_unreach"
	json_add_boolean internet_unreachable "$inet_unreach"
	json_add_boolean dns_failed "$dns_fail"
	json_close_object

	json_add_object facts
	json_add_string mode_id "${mode_id:-}"
	json_add_string default_gw "${gw:-}"
	[ -n "$gw_rtt" ] && json_add_int gw_rtt_ms "$gw_rtt"
	[ -n "$inet_rtt" ] && json_add_int inet_rtt_ms "$inet_rtt"
	json_add_string dns_test_host "$dns_host"
	json_close_object

	if [ "$total" -eq 0 ]; then
		json_add_string summary "Uplink: الاتصال سليم (بوابة ${gw:-?} — ${gw_rtt:-?}ms، إنترنت ${inet_rtt:-?}ms)"
		json_add_int rc 0
	else
		json_add_string summary "Uplink: تم اكتشاف $total مشكلة"
		json_add_int rc 1
	fi

	json_dump
}

main
