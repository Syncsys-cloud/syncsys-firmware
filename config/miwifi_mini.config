CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_xiaomi_miwifi-mini=y

# Firmware Images (NOR Flash 16MB)
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ========================================
# PERFORMANCE OPTIMIZATIONS (أداء عالي)
# ========================================
# Use musl (default, lightest libc)
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
# Disable unnecessary kernel debugging
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_FTRACE is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_KERNEL_AIO is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# Optimize for size
CONFIG_PKG_CC_STACKPROTECTOR_NONE=y

# ========================================
# 1. LuCI Web Interface & Themes
# ========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-i18n-base-en=y
CONFIG_PACKAGE_luci-i18n-argon-config-ar=y
CONFIG_LUCI_LANG_ar=y
CONFIG_LUCI_LANG_en=y

# ========================================
# 2. Wi-Fi Repeater / Extender (ريبيتر)
# ========================================
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y
CONFIG_PACKAGE_luci-app-travelmate=y
CONFIG_PACKAGE_luci-i18n-travelmate-ar=y
CONFIG_PACKAGE_travelmate=y

# ========================================
# 3. Mesh Networking (802.11s + Steering)
# ========================================
CONFIG_PACKAGE_wpad-openssl=y
# MUST exclude default wpad variants
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_kmod-cfg80211=y

# ========================================
# 4. Network & Multi-WAN (دمج الخطوط)
# ========================================
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-ar=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-ar=y
CONFIG_PACKAGE_sqm-scripts=y

# ========================================
# 5. Monitoring & Controls
# ========================================
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-ar=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-ar=y

# ========================================
# 6. Firewall & Security
# ========================================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-ar=y

# ========================================
# 7. System Tools (Essential Only - 16MB)
# ========================================
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-ar=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-ar=y

# ========================================
# REMOVE BLOAT (توفير مساحة)
# ========================================
# CONFIG_PACKAGE_luci-app-wifischedule is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-access-control is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
