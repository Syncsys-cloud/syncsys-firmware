# Force Unix LF line endings for all files that go into firmware
*.ut text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.config text eol=lf
*.conf text eol=lf
*.yml text eol=lf
banner text eol=lf
# UCI config files (no extension)
files/etc/config/* text eol=lf

