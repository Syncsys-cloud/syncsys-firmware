#!/bin/sh
# mkdector - VLAN/Bridge/Wi-Fi binding checks (for AP+VLAN modes)

. /usr/share/libubox/jshn.sh 2>/dev/null

UCI=/sbin/uci

uci_get() { $UCI -q get "$1" 2>/dev/null; }
uci_has() { $UCI -q show "$1" >/dev/null 2>&1; }

get_mode_id() {
	# Prefer cached topology result if available (rpcd keeps /tmp/mkdector/<section>.result.json)
	local f="/tmp/mkdector/topology.result.json"
	if [ -r "$f" ] && command -v jsonfilter >/dev/null 2>&1; then
		jsonfilter -i "$f" -e '@.facts.mode_id' 2>/dev/null
		return
	fi
	# Fallback: run topology checker
	if [ -x /usr/libexec/mkdector/topology/mkchecktopology ] && command -v jsonfilter >/dev/null 2>&1; then
		/usr/libexec/mkdector/topology/mkchecktopology | jsonfilter -e '@.facts.mode_id' 2>/dev/null
		return
	fi
	echo ""
}

first_vid() {
	# take first bridge-vlan vlan id (common in your deployments)
	local vid
	vid="$(uci_get 'network.@bridge-vlan[0].vlan')"
	[ -n "$vid" ] && echo "$vid" && return
	# fallback: parse uci show
	vid="$($UCI -q show network 2>/dev/null | sed -n 's/.*=bridge-vlan//p' | head -n1)"
	echo ""
}

wifi_collect() {
	json_add_array wifi_ifaces
	local ifaces sec
	ifaces="$($UCI -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^=]*\)=wifi-iface.*/\1/p')"
	for sec in $ifaces; do
		local mode network wds ssid dev band
		mode="$(uci_get "wireless.$sec.mode")"
		network="$(uci_get "wireless.$sec.network")"
		wds="$(uci_get "wireless.$sec.wds")"
		ssid="$(uci_get "wireless.$sec.ssid")"
		dev="$(uci_get "wireless.$sec.device")"
		band=""
		[ -n "$dev" ] && band="$(uci_get "wireless.$dev.band")"
		[ -z "$band" ] && [ -n "$dev" ] && band="$(uci_get "wireless.$dev.hwmode")"

		json_add_object ""
		json_add_string section "$sec"
		json_add_string band "${band:-}"
		json_add_string mode "${mode:-}"
		json_add_boolean wds "$( [ "$wds" = "1" ] && echo 1 || echo 0 )"
		json_add_string ssid "${ssid:-}"
		json_add_string network "${network:-}"
		json_close_object
	done
	json_close_array
}

main() {
	local mode_id vid
	mode_id="$(get_mode_id)"
	vid="$(uci_get 'network.@bridge-vlan[0].vlan')"

	json_init
	json_add_object issues
	json_add_boolean br_vlan_missing 0
	json_add_boolean vlan_iface_missing 0
	json_add_boolean vlan_iface_wrong_device 0
	json_add_boolean ssid_bound_to_lan_in_vlan_mode 0
	json_add_boolean not_vlan_mode 0
	json_close_object

	json_add_object facts
	json_add_string mode_id "${mode_id:-}"

	# mark if not in vlan modes
	case "$mode_id" in
		ap_vlan|ap_vlan_mesh|ap_vlan_wds_tx|ap_vlan_wds_rx) : ;;
		*) json_add_boolean is_vlan_mode 0; json_close_object; json_dump; return ;;
	esac
	json_add_boolean is_vlan_mode 1

	# Detect br-vlan device
	local brv_ports
	brv_ports="$(uci_get 'network.br-vlan.ports')"
	[ -z "$brv_ports" ] && brv_ports="$(uci_get 'network.br_vlan.ports')"
	json_add_string br_vlan_ports "${brv_ports:-}"
	if ! uci_has 'network.br-vlan' && ! uci_has 'network.br_vlan'; then
		json_add_boolean br_vlan_exists 0
		json_set_key issues br_vlan_missing
		json_add_boolean br_vlan_missing 1
	else
		json_add_boolean br_vlan_exists 1
	fi

	# Detect VLAN interface
	if ! uci_has 'network.vlan'; then
		json_add_boolean vlan_iface_exists 0
		json_set_key issues vlan_iface_missing
		json_add_boolean vlan_iface_missing 1
	else
		json_add_boolean vlan_iface_exists 1
		local proto dev
		proto="$(uci_get 'network.vlan.proto')"
		dev="$(uci_get 'network.vlan.device')"
		json_add_string vlan_proto "${proto:-}"
		json_add_string vlan_device "${dev:-}"
		if [ "$proto" != "none" ] || [ "$dev" != "br-vlan" ]; then
			json_set_key issues vlan_iface_wrong_device
			json_add_boolean vlan_iface_wrong_device 1
		fi
	fi

	# wifi bindings summary + check
	wifi_collect

	# Determine expected bindings
	local ifaces sec
	local bad=0
	ifaces="$($UCI -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^=]*\)=wifi-iface.*/\1/p')"
	for sec in $ifaces; do
		local wmode wds net
		wmode="$(uci_get "wireless.$sec.mode")"
		wds="$(uci_get "wireless.$sec.wds")"
		net="$(uci_get "wireless.$sec.network")"

		# Mesh should stay on lan
		if [ "$wmode" = "mesh" ]; then
			[ "$net" = "lan" ] || bad=1
			continue
		fi

		# WDS link (ap/sta with wds=1) should stay on lan in your templates
		if [ "$wds" = "1" ] && { [ "$wmode" = "ap" ] || [ "$wmode" = "sta" ]; }; then
			[ "$net" = "lan" ] || bad=1
			continue
		fi

		# Normal APs should be on vlan
		if [ "$wmode" = "ap" ]; then
			[ "$net" = "vlan" ] || bad=1
		fi
	done

	if [ "$bad" -eq 1 ]; then
		json_set_key issues ssid_bound_to_lan_in_vlan_mode
		json_add_boolean ssid_bound_to_lan_in_vlan_mode 1
	fi

	json_close_object
	json_dump
}

main
