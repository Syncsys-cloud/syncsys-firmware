#!/bin/sh
# mkdector - baseline repair (safe)
#
# Params (from rpcd):
#   MK_SECTION, MK_SOLUTION, MK_ISSUES

UCI="/sbin/uci"
RUNDIR="/tmp/mkdector"

log() { echo "[baseline] $*"; }

svc_stop_disable() {
	local s="$1"
	[ -x "/etc/init.d/$s" ] || return 0
	/etc/init.d/$s stop >/dev/null 2>&1 || true
	/etc/init.d/$s disable >/dev/null 2>&1 || true
}

svc_start_enable() {
	local s="$1"
	[ -x "/etc/init.d/$s" ] || return 0
	/etc/init.d/$s enable >/dev/null 2>&1 || true
	/etc/init.d/$s restart >/dev/null 2>&1 || /etc/init.d/$s start >/dev/null 2>&1 || true
}

detect_mode_id() {
	local rf="$RUNDIR/topology.result.json"
	if [ -s "$rf" ] && command -v jsonfilter >/dev/null 2>&1; then
		jsonfilter -i "$rf" -e '@.facts.mode_id' 2>/dev/null
		return
	fi
	if [ -x /usr/libexec/mkdector/topology/mkchecktopology ]; then
		/usr/libexec/mkdector/topology/mkchecktopology >"$RUNDIR/topology.result.json" 2>/dev/null || true
		if [ -s "$RUNDIR/topology.result.json" ] && command -v jsonfilter >/dev/null 2>&1; then
			jsonfilter -i "$RUNDIR/topology.result.json" -e '@.facts.mode_id' 2>/dev/null
			return
		fi
	fi
	echo "ap"
}

delete_iface_if_exists() {
	local name="$1"
	$UCI -q show "network.$name" >/dev/null 2>&1 || return 0
	log "delete network.$name"
	$UCI -q delete "network.$name" || true
}

main() {
	local sol="${MK_SOLUTION:-auto}"
	local mode_id
	mode_id="$(detect_mode_id)"

	log "mode_id=$mode_id solution=$sol"

	case "$sol" in
		auto|safe)
			# 1) Remove WAN stanzas if present (your AP templates)
			delete_iface_if_exists wan
			delete_iface_if_exists wan6

			# 2) Ensure DHCP server is stopped for LAN (dhcp.lan.ignore=1)
			log "set dhcp.lan.ignore=1"
			$UCI -q set dhcp.lan.ignore='1' || true
			$UCI -q commit dhcp || true

			# 3) Services: apply your common policy
			# - firewall stopped in all listed modes
			svc_stop_disable firewall
			svc_stop_disable odhcpd

			if [ "$mode_id" = "ap_broadband" ]; then
				# broadband per your description: dnsmasq enabled
				svc_start_enable dnsmasq
			else
				svc_stop_disable dnsmasq
			fi

			# 4) Commit network changes (if any) and reload
			$UCI -q commit network || true
			/etc/init.d/network reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1 || true
			log "done"
			;;
		*)
			log "unknown solution: $sol"
			;;
	esac
}

main
