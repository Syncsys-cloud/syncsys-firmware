#!/bin/sh
# ====================================================================
# SyncSys.cloud Safe First-Boot Initialization
# Runs dynamically after OpenWrt detects hardware & generates switch/radios
# ====================================================================

# 1. Ensure LAN IP is 192.168.1.1
if [ -n "$(uci -q get network.lan)" ]; then
	uci -q set network.lan.ipaddr='192.168.1.1'
	uci -q set network.lan.netmask='255.255.255.0'
	uci -q commit network
fi

# 2. Configure WiFi Safely (SSID & Password)
if [ -f /etc/config/wireless ]; then
	# Configure Radio 0 (typically 2.4GHz)
	if [ -n "$(uci -q get wireless.radio0)" ]; then
		uci -q set wireless.radio0.country='SA'
		uci -q set wireless.radio0.disabled='0'
	fi

	# Configure Radio 1 (typically 5GHz, if present)
	if [ -n "$(uci -q get wireless.radio1)" ]; then
		uci -q set wireless.radio1.country='SA'
		uci -q set wireless.radio1.disabled='0'
	fi

	# Configure default interfaces
	idx=0
	while true; do
		iface="wireless.@wifi-iface[$idx]"
		device=$(uci -q get "${iface}.device")
		[ -z "$device" ] && break

		if [ "$device" = "radio0" ]; then
			uci -q set "${iface}.ssid=SyncSys-Cloud"
			uci -q set "${iface}.encryption=psk2"
			uci -q set "${iface}.key=SyncSys2026"
		elif [ "$device" = "radio1" ]; then
			uci -q set "${iface}.ssid=SyncSys-Cloud-5G"
			uci -q set "${iface}.encryption=psk2"
			uci -q set "${iface}.key=SyncSys2026"
		fi
		idx=$((idx + 1))
	done
	uci -q commit wireless
fi

# 3. Set Argon Dark Mode Default
if [ -f /etc/config/argon ]; then
	uci -q set argon.@global[0].mode='dark'
	uci -q set argon.@global[0].primary='#0ea5e9'
	uci -q set argon.@global[0].dark_primary='#0284c7'
	uci -q commit argon
fi

# 4. Set Timezone to Asia/Riyadh (GMT+3)
uci -q set system.@system[0].zonename='Asia/Riyadh'
uci -q set system.@system[0].timezone='<+03>-3'
uci -q commit system

# 5. Make all executables and daemons executable
chmod +x /usr/libexec/syncsys/*.sh 2>/dev/null
chmod +x /usr/libexec/mk*/*.sh 2>/dev/null
chmod +x /usr/libexec/mk*/*-core 2>/dev/null
chmod +x /usr/libexec/mk*/*-verify 2>/dev/null
chmod +x /usr/libexec/portisolation/* 2>/dev/null
chmod +x /etc/init.d/syncsys-agent 2>/dev/null
chmod +x /etc/init.d/portisolation 2>/dev/null
chmod +x /etc/init.d/mk-swmode 2>/dev/null

# 6. Enable and start SyncSys Agent
/etc/init.d/syncsys-agent enable 2>/dev/null
/etc/init.d/syncsys-agent start 2>/dev/null

exit 0

