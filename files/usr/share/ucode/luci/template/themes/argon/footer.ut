		</div>
	</div>
		<footer class="mobile-hide" style="text-wrap: auto">
			<div class="footer-content" style="display: flex; flex-wrap: wrap; gap: 0.5em; justify-content: center; direction: rtl;">
				<div style="width:100%;text-align:center;margin-bottom:4px;">
					<b style="color:#00d2ff;font-size:14px;">☁️ SyncSys.cloud OS</b>
					<span style="color:#64748b;"> • </span>
					<span style="color:#94a3b8;font-size:12px;">النسخة المؤسسية المتطورة</span>
				</div>
				<span style="color:#64748b;font-size:11px;">
					Powered by {{ version.luciname }} ({{ version.luciversion }}) •
					{{ version.distname }} {{ version.distversion }}
					• © 2026 SyncSys.cloud
				</span>
			</div>
		</footer>
	</div>
</div>
<script>
	// thanks for Jo-Philipp Wich <jow@openwrt.org>
	var luciLocation = {{ ctx.path }};
	var winHeight = window.innerHeight;
	window.addEventListener('resize', function () {
		var winWidth = window.innerWidth;
		if(winWidth < 600){
			var newHeight = window.innerHeight;
			var keyboradHeight = newHeight - winHeight;
			var ftcElement = document.querySelector(".ftc");
			if (ftcElement) {
				ftcElement.style.bottom = (keyboradHeight + 30) + "px";
			}
		}
	});
</script>
<script type="text/javascript">L.require('menu-argon')</script>
</body>
</html>
