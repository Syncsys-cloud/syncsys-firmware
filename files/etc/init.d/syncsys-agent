#!/bin/sh /etc/rc.common
# Copyright (c) 2026 SyncSys.cloud

START=99
STOP=10
USE_PROCD=1

PROG="/usr/libexec/syncsys/syncsys-agent.sh"

start_service() {
	local enabled=$(uci -q get syncsys.main.enabled || echo "1")
	[ "$enabled" != "1" ] && return 0

	chmod +x "$PROG" 2>/dev/null

	procd_open_instance
	procd_set_param command /bin/sh "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -9 syncsys-agent.sh 2>/dev/null || true
}

reload_service() {
	stop
	start
}

